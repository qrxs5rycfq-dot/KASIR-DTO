# ============================================
# KASIR MODERN - Environment Configuration
# ============================================
# Salin file ini menjadi .env dan sesuaikan nilai-nilainya
# Copy this file to .env and adjust the values
# ============================================

# ===========================================
# FLASK CONFIGURATION
# ===========================================

# Secret key untuk session dan keamanan aplikasi
# Ganti dengan string acak yang panjang untuk production!
SECRET_KEY=your-super-secret-key-change-this-in-production

# Mode debug (true/false)
# Set ke 'false' untuk production
FLASK_DEBUG=true

# Environment mode (development/production)
# Set ke 'production' untuk production (enables secure cookies)
FLASK_ENV=development

# URL aplikasi (untuk generate QR Code)
# Kosongkan untuk auto-detect dari request domain
# Isi dengan domain production jika menggunakan domain, contoh: https://kasir.example.com
# APP_URL=https://kasir.example.com
APP_URL=

# SocketIO CORS origins (* untuk semua, atau domain tertentu)
SOCKETIO_CORS_ORIGINS=*

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# Gunakan MySQL (true) atau SQLite (false)
# SQLite lebih mudah untuk development, MySQL untuk production
USE_MYSQL=false

# Konfigurasi MySQL (hanya digunakan jika USE_MYSQL=true)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=kasir_db

# ===========================================
# MIDTRANS PAYMENT GATEWAY
# ===========================================

# Dapatkan key dari https://dashboard.midtrans.com
# Untuk testing, gunakan Sandbox keys (SB-Mid-...)
# Untuk production, gunakan Production keys

# Server Key (untuk backend)
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXXXXXXXXXXXX

# Client Key (untuk frontend)
MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXXXXXXXXXXX

# Mode production (true/false)
# Set ke 'false' untuk Sandbox/testing
MIDTRANS_IS_PRODUCTION=false

# ===========================================
# BRI QRIS PAYMENT GATEWAY
# ===========================================

# Dapatkan dari BRI API Portal
BRI_CLIENT_ID=
BRI_CLIENT_SECRET=
BRI_MERCHANT_ID=
BRI_TERMINAL_ID=
BRI_PRIVATE_KEY_PATH=
BRI_IS_PRODUCTION=false

# ===========================================
# TRIPAY PAYMENT GATEWAY
# ===========================================

# Dapatkan dari https://tripay.co.id/member/merchant
# Sandbox: https://tripay.co.id/simulator/merchant
TRIPAY_API_KEY=DEV-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TRIPAY_PRIVATE_KEY=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
TRIPAY_MERCHANT_CODE=T00000
TRIPAY_IS_PRODUCTION=false

# ===========================================
# DUITKU PAYMENT GATEWAY
# ===========================================

# Dapatkan dari https://dashboard.duitku.com
# Sandbox: https://sandbox.duitku.com
DUITKU_API_KEY=
DUITKU_MERCHANT_CODE=
DUITKU_IS_PRODUCTION=false

# ===========================================
# DOKU CHECKOUT PAYMENT GATEWAY
# ===========================================

# Dapatkan dari https://dashboard.doku.com → Settings → API Keys
# Sandbox: https://sandbox.doku.com
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_IS_PRODUCTION=false

# ===========================================
# FIREBASE CLOUD MESSAGING (FCM)
# ===========================================

# Push notification ke perangkat Android menggunakan Firebase Admin SDK
# 1. Buka Firebase Console → Project Settings → Service accounts
# 2. Klik "Generate new private key" → download JSON file
# 3. Simpan file JSON di server (misal: /path/to/firebase-service-account.json)
# 4. Set path file di bawah ini
GOOGLE_APPLICATION_CREDENTIALS=firebase-service-account.json

