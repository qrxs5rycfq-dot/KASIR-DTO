<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <solid android:color="#2563eb" />
            <corners android:topLeftRadius="8dp" android:bottomLeftRadius="8dp" />
            <stroke android:width="1dp" android:color="#3b82f6" />
        </shape>
    </item>
    <item android:state_checked="false">
        <shape>
            <solid android:color="#334155" />
            <corners android:topLeftRadius="8dp" android:bottomLeftRadius="8dp" />
            <stroke android:width="1dp" android:color="#475569" />
        </shape>
    </item>
</selector>