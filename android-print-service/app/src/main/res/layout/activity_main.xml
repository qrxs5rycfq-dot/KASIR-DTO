<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f172a">

    <!-- Layer 1: WebView full-screen -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:ignore="MissingClass">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Layer 2: Floating status bar (compact, top-right to avoid covering sidebar toggle) -->
    <LinearLayout
        android:id="@+id/floatingStatusBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/status_bar_background"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp"
        android:elevation="8dp">

        <!-- Settings Button (FAB-like) -->
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="⚙️"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:background="@drawable/fab_background"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp" />

        <!-- Service status indicator -->
        <TextView
            android:id="@+id/txtServiceStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔴"
            android:textSize="10sp"
            android:textColor="#94a3b8"
            android:paddingStart="6dp"
            android:paddingEnd="2dp"
            android:visibility="gone" />

        <!-- Service toggle (compact) -->
        <Button
            android:id="@+id/btnToggleService"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="▶"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/button_rounded"
            android:backgroundTint="#059669"
            android:minWidth="36dp"
            android:paddingHorizontal="8dp"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <!-- Hidden print stats (kept for compatibility but always GONE) -->
    <TextView
        android:id="@+id/txtPrintStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:ignore="SmallSp" />

    <!-- Layer 3: Tap-to-close backdrop (invisible, behind settings panel) -->
    <View
        android:id="@+id/settingsBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

    <!-- Layer 3: Settings panel (floating card, right-center, above WebView) -->
    <ScrollView
        android:id="@+id/settingsPanel"
        android:layout_width="@dimen/settings_panel_width"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/settings_panel_background"
        android:visibility="gone"
        android:fillViewport="false"
        android:elevation="24dp"
        android:translationX="@dimen/settings_panel_slide_offset">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header with close button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚙️ Pengaturan"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Printer &amp; Server"
                        android:textColor="#64748b"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnCloseSettings"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="✕"
                    android:textSize="16sp"
                    android:textColor="#94a3b8"
                    android:background="@drawable/button_circular"
                    android:backgroundTint="#1e293b"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp" />
            </LinearLayout>

            <!-- Card: Server -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐 SERVER"
                    android:textColor="#60a5fa"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/editServerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="http://10.111.108.37:8000"
                    android:textColor="@android:color/white"
                    android:textColorHint="#475569"
                    android:background="@drawable/edittext_background"
                    android:paddingHorizontal="14dp"
                    android:textSize="13sp"
                    android:inputType="textUri"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <EditText
                        android:id="@+id/editUsername"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:hint="Username"
                        android:textColor="@android:color/white"
                        android:textColorHint="#475569"
                        android:background="@drawable/edittext_background"
                        android:paddingHorizontal="14dp"
                        android:textSize="13sp"
                        android:layout_marginEnd="6dp" />

                    <EditText
                        android:id="@+id/editPassword"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:hint="Password"
                        android:textColor="@android:color/white"
                        android:textColorHint="#475569"
                        android:background="@drawable/edittext_background"
                        android:paddingHorizontal="14dp"
                        android:textSize="13sp"
                        android:inputType="textPassword" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card: Printer Type -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🖨️ PRINTER"
                    android:textColor="#60a5fa"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="10dp" />

                <RadioGroup
                    android:id="@+id/radioPrinterType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <RadioButton
                        android:id="@+id/radioBluetooth"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="🔵 Bluetooth"
                        android:textColor="#e2e8f0"
                        android:buttonTint="#3b82f6"
                        android:checked="true"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:background="@drawable/radio_button_left"
                        android:padding="6dp" />

                    <RadioButton
                        android:id="@+id/radioLan"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="🌐 LAN"
                        android:textColor="#e2e8f0"
                        android:buttonTint="#3b82f6"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:background="@drawable/radio_button_right"
                        android:padding="6dp" />
                </RadioGroup>
            </LinearLayout>

            <!-- Card: Bluetooth Section -->
            <LinearLayout
                android:id="@+id/sectionBluetooth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="14dp"
                android:layout_marginBottom="12dp"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/spinnerPrinter"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/spinner_background"
                        android:paddingHorizontal="10dp"
                        android:popupBackground="#1e293b"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnRefreshPrinters"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="🔄"
                        android:textSize="16sp"
                        android:background="@drawable/button_rounded"
                        android:backgroundTint="#334155"
                        android:layout_marginStart="6dp"
                        android:minWidth="0dp"
                        android:padding="0dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 Pastikan Bluetooth aktif dan printer sudah dipasangkan"
                    android:textColor="#475569"
                    android:textSize="10sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Card: LAN Section -->
            <LinearLayout
                android:id="@+id/sectionLan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="14dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/editLanAddress"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="192.168.1.100:9100"
                    android:textColor="@android:color/white"
                    android:textColorHint="#475569"
                    android:background="@drawable/edittext_background"
                    android:paddingHorizontal="14dp"
                    android:textSize="13sp"
                    android:inputType="text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📌 Pastikan printer dan HP dalam satu jaringan"
                    android:textColor="#475569"
                    android:textSize="10sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Card: Paper Width -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="14dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📄 KERTAS"
                    android:textColor="#60a5fa"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="8dp" />

                <Spinner
                    android:id="@+id/spinnerPaperWidth"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/spinner_background"
                    android:paddingHorizontal="10dp"
                    android:popupBackground="#1e293b"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Save Button -->
            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="💾 SIMPAN"
                android:textColor="@android:color/white"
                android:background="@drawable/button_gradient"
                android:textStyle="bold"
                android:textSize="14sp"
                android:letterSpacing="0.03"
                android:layout_marginBottom="12dp"
                android:elevation="4dp" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>